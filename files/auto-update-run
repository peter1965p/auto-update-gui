#!/bin/bash
# Wird vom systemd-Service aufgerufen: optional Snapshot, pacman -Syu, optional AUR
# Die "[auto-update] Phase: ..."-Zeilen wertet die GUI für die Ablaufanzeige aus.
set -u
[ -r /etc/auto-update.conf ] && . /etc/auto-update.conf
SNAPSHOT=${SNAPSHOT:-1}
AUR=${AUR:-0}
AUR_USER=${AUR_USER:-}
IGNORE=${IGNORE:-}

phase() { echo "[auto-update] Phase: $1"; }

if [ "$SNAPSHOT" = 1 ] && snapper list-configs 2>/dev/null | grep -qw root; then
    phase snapshot
    snapper -c root create -c number -d "vor Auto-Update" || echo "Snapshot fehlgeschlagen, fahre trotzdem fort"
fi

# Ausnahmeliste: diese Pakete weder mit pacman noch mit paru aktualisieren
IGN_ALL=$IGNORE
if [ -n "$IGNORE" ]; then
    echo "[auto-update] Ausnahmeliste (wird übersprungen): ${IGNORE//,/, }"
fi

# Ausgesetzte Pakete (fehlgeschlagen, warten auf ein Folge-Update des Betreuers): Gibt es im AUR inzwischen eine andere
# Version, wird die Aussetzung beendet und es erneut versucht; sonst bleibt das Paket außen vor.
STATE=/var/lib/auto-update/suspended
if [ -s "$STATE" ]; then
    while IFS=$'\t' read -r spkg sver _sdate; do
        [ -n "$spkg" ] || continue
        cur=$(curl -g -fsS -m 15 "https://aur.archlinux.org/rpc/v5/info?arg[]=$spkg" 2>/dev/null | python3 -c '
import sys, json
try:
    r = json.load(sys.stdin)["results"]
    print(r[0]["Version"] if r else "")
except Exception:
    print("")' 2>/dev/null)
        if [ -n "$cur" ] && [ "$cur" != "$sver" ]; then
            echo "[auto-update] Folge-Update für $spkg gefunden ($sver -> $cur): Aussetzung beendet, versuche es erneut"
            awk -F'\t' -v p="$spkg" '$1 != p' "$STATE" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
        else
            IGN_ALL="${IGN_ALL:+$IGN_ALL,}$spkg"
            echo "[auto-update] Ausgesetzt (wartet auf Folge-Update): $spkg ($sver)"
        fi
    done < "$STATE"
fi
IGN_ARGS=()
[ -z "$IGN_ALL" ] || IGN_ARGS=(--ignore "$IGN_ALL")

phase pacman
/usr/bin/pacman -Syu --noconfirm ${IGN_ARGS[@]+"${IGN_ARGS[@]}"}
rc=$?

if [ "$AUR" = 1 ] && [ -n "$AUR_USER" ]; then
    phase aur
    echo "== AUR-Update (als $AUR_USER) =="
    # paru läuft über runuser in der Sitzung des Benutzers; die Journal-Zeilen eines solchen Prozesses gehören nicht zum
    # Dienst. Die Ausgabe deshalb durch den Dienst leiten (| cat), damit sie im Journal dieses Laufs steht.
    AUR_HOME=$(getent passwd "$AUR_USER" | cut -d: -f6)
    (cd "$AUR_HOME" && runuser -u "$AUR_USER" -- env HOME="$AUR_HOME" USER="$AUR_USER" LOGNAME="$AUR_USER" \
        PATH=/usr/local/bin:/usr/bin paru -Sua --noconfirm --skipreview ${IGN_ARGS[@]+"${IGN_ARGS[@]}"}) 2>&1 | cat
    [ "${PIPESTATUS[0]}" -eq 0 ] || rc=1
fi
phase done
exit $rc
