    dark = app.palette().color(QPalette.ColorRole.Window).lightness() < 128
    t = dict(dark=dark, accent=app.palette().color(QPalette.ColorRole.Highlight).name(),
             ok="#2ecc71", warn="#f5a623", err="#e5534b")
