#!/usr/bin/env python3
"""Startet das SoftCenter (Software, System und Updates). Findet das Paket neben diesem Skript oder unter /usr/local/lib."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for base in (here, "/usr/local/lib/auto-update-gui"):
    if os.path.isdir(os.path.join(base, "softcenter")):
        sys.path.insert(0, base)
        break

from softcenter.app import main  # noqa: E402

sys.exit(main())
