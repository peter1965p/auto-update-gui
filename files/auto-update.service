[Unit]
Description=Automatisches Systemupdate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Standby/Shutdown während des Updates verhindern
ExecStart=/usr/bin/systemd-inhibit --what=sleep:shutdown --who=auto-update --why="Systemupdate läuft" /usr/local/bin/auto-update-run
